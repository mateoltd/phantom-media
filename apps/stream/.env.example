# Canonical public origin, used for metadata, canonical URLs and the sitemap.
NEXT_PUBLIC_BASE_URL=https://stream.example.com

# Origin of the upstream resolver. Override to point at a mirror without
# touching code; the client falls back to its built-in default when unset.
RELAY_BASE_URL=

# Optional public, unauthenticated Stremio addon manifests. Each configured
# HTTPS manifest becomes one stable Source slot. Duplicate URLs are ignored.
STREMIO_ADDON_URL_1=
STREMIO_ADDON_URL_2=
STREMIO_ADDON_URL_3=

# Only read by the standalone resolver in src/server.mjs: the browser origins
# it will answer. The Next app does not use it.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Where infringement notices are received. The disclaimer page omits its
# reporting section until this is set because a takedown route with no address
# behind it is worse than none.
NEXT_PUBLIC_NOTICE_EMAIL=

# Full local trace mode. In development this enables the browser and server
# decision logs, prints the server half to stdout, and appends the combined
# redacted NDJSON stream to .debug/phantom-stream.ndjson.
DEBUG=

# Backwards-compatible server-only flag. Prefer DEBUG=1 for a complete trace.
STREAM_DEBUG=

# Optional path override for the DEBUG=1 NDJSON trace.
STREAM_DEBUG_LOG=

# Starts every session with the browser log already running. Useful on a
# staging build; leave unset otherwise, since it prints on every page.
NEXT_PUBLIC_STREAM_DEBUG=

# Vidfast currently resolves to this public media CDN. Add exact public DNS
# names here if its rotation changes; the media relay refuses every other host.
VIDFAST_MEDIA_HOSTS=

# Vidsrc uses the same explicit media-host allowlist policy. Add only exact
# public DNS names reviewed for the deployment; all other relay targets fail
# closed.
VIDSRC_MEDIA_HOSTS=
