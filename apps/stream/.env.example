# Canonical public origin, used for metadata, canonical URLs and the sitemap.
NEXT_PUBLIC_BASE_URL=https://stream.example.com

# Origin of the upstream resolver. Override to point at a mirror without
# touching code; the client falls back to its built-in default when unset.
RELAY_BASE_URL=

# Only read by the standalone resolver in src/server.mjs: the browser origins
# it will answer. The Next app does not use it.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Where infringement notices are received. The disclaimer page omits its
# reporting section entirely until this is set — a takedown route with no
# address behind it is worse than none.
NEXT_PUBLIC_NOTICE_EMAIL=
