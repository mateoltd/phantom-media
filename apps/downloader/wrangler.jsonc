{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ewyoutube",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  // Keep the gateway uncached so it can reject junk paths and route APIs.
  // Only immutable assets receive Workers output caching. HTML contains
  // build-specific asset hashes and must move atomically with the container.
  "cache": {
    "enabled": false
  },
  "exports": {
    "CachedAssets": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    }
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ewyoutube.com",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["EWYOUTUBE_PROXY_URLS"]
  },
  "containers": [
    {
      "class_name": "PhantomContainer",
      "image": "./Dockerfile",
      // The build needs the workspace root: this app is compiled against
      // packages/ui and packages/theme, which sit outside its folder.
      "image_build_context": "../..",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PHANTOM_CONTAINER",
        "class_name": "PhantomContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PhantomContainer"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
