{
  "name": "@phantom/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React components shared by the Phantom apps. Consumed as source and compiled by each app.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.tsx",
    "./playback-segments": "./src/playback-segments.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "peerDependencies": {
    "next": "*",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@phantom/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@phosphor-icons/react": "catalog:"
  }
}
