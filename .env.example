# Optional but recommended on hosts whose datacenter ASN is blocked.
# Use an HTTP(S) static/sticky ISP proxy whose provider explicitly
# permits this traffic. The same value is used for YouTube.js and yt-dlp.
EWYOUTUBE_PROXY_URL=http://username:password@proxy.example:12345

# Public feature switch baked into the frontend at build time.
NEXT_PUBLIC_DOWNLOADS_RESTRICTED=false

# Canonical public origin used for metadata, canonical URLs, and sitemaps.
NEXT_PUBLIC_BASE_URL=https://phantom.example.com

# Process and queue limits for a small public deployment.
DOWNLOAD_MAX_CONCURRENT=2
DOWNLOAD_MAX_PENDING=20
DOWNLOAD_MAX_JOBS_PER_IP=3
DOWNLOAD_MAX_DURATION_SECONDS=14400
DOWNLOAD_MAX_FILESIZE=2G
# Disk budget for jobs in flight. Each job reserves roughly the size of the
# media it asked for, so this is a real ceiling rather than a job counter.
DOWNLOAD_MAX_TEMP_BYTES=8589934592
DOWNLOAD_JOB_TIMEOUT_SECONDS=1800
RESOLVE_MAX_PLAYLIST_ITEMS=100

# Optional trusted ingress header used for per-client limits. Examples:
# cf-connecting-ip (Cloudflare), fly-client-ip (Fly.io), x-forwarded-for.
DOWNLOAD_CLIENT_IP_HEADER=x-forwarded-for

# Included in the Docker image. Override these only for a custom host.
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
DOWNLOAD_TEMP_DIR=/tmp/ewyoutube-downloads
